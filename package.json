{
  "name": "codigo_servidor",
  "version": "1.0.0",
  "description": "Sistema de nube distribuible con autenticación y gestión de archivos",
  "main": "server/server.js",
  "dependencies": {
    "@azure/msal-node": "^3.8.0",
    "@fullcalendar/core": "^6.1.19",
    "@fullcalendar/daygrid": "^6.1.19",
    "@fullcalendar/interaction": "^6.1.19",
    "@fullcalendar/react": "^6.1.19",
    "@fullcalendar/timegrid": "^6.1.19",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "body-parser": "^1.20.2",
    "chokidar": "^3.5.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-session": "^1.18.2",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "mkdirp": "^3.0.1",
    "mongoose": "^7.5.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.9.4",
    "react-scripts": "^5.0.1",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2",
    "uuid": "^9.0.0",
    "web-vitals": "^5.1.0"
  },
  "scripts": {
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "build": "react-scripts build",
    "client": "react-scripts start",
    "server": "node server/server.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "init-sync": "node init-sync-system.js",
    "server-only": "node server/server.js",
    "dev-server": "nodemon server/server.js",
    "sync-service": "node sync-system/services/SyncService.js",
    "test-sync": "node -e \"const SyncService = require('./sync-system/services/SyncService'); new SyncService().testConnection();\"",
    "setup": "npm run init-sync && npm install",
    "clean": "rm -rf node_modules package-lock.json && npm install",
    "logs": "tail -f logs/*.log",
    "backup-db": "mongodump --db nube_distribuible --out ./backups/$(date +%Y%m%d_%H%M%S)",
    "health-check": "node check-system-health.js",
    "status": "npm run health-check"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "http://localhost:5000",
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "http-proxy-middleware": "^3.0.5",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18"
  }
}
