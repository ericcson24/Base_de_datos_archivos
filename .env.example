# ============================================
# VARIABLES DE ENTORNO - NUBE DISTRIBUIBLE
# ============================================

# =====================================
# CONFIGURACIÓN PRINCIPAL DEL SERVIDOR
# =====================================

# Puerto principal de la aplicación
PORT=5000

# URL de conexión a MongoDB
MONGODB_URL=mongodb://localhost:27017/nube_distribuible

# Clave secreta para sesiones (cambiar en producción)
SESSION_SECRET=tu_clave_secreta_super_segura_aqui_123456789

# URL del cliente frontend
CLIENT_URL=http://localhost:3000

# =====================================
# SERVICIO DE SINCRONIZACIÓN
# =====================================

# Puerto para el servicio de sincronización
SYNC_PORT=5001

# Número máximo de sincronizaciones concurrentes
MAX_CONCURRENT_SYNCS=5

# Intervalo de verificación de sincronización (ms)
SYNC_INTERVAL=30000

# Número de intentos de reintento en caso de fallo
RETRY_ATTEMPTS=3

# Tamaño de lote para procesamiento de archivos
BATCH_SIZE=10

# =====================================
# CONFIGURACIÓN DE REDIS (OPCIONAL)
# =====================================

# URL de conexión a Redis para caché
# REDIS_URL=redis://localhost:6379

# Tiempo de expiración de caché (segundos)
CACHE_TTL=3600

# =====================================
# CONFIGURACIÓN DE SEGURIDAD
# =====================================

# Clave secreta para JWT (cambiar en producción)
JWT_SECRET=jwt_secret_key_muy_seguro_para_tokens

# Clave de cifrado AES-256 (32 caracteres)
ENCRYPTION_KEY=encryption_key_32_chars_long_1234

# Tiempo de expiración de tokens JWT (segundos)
JWT_EXPIRATION=86400

# =====================================
# CONFIGURACIÓN DE INTELIGENCIA ARTIFICIAL
# =====================================

# Intervalo de aprendizaje de la IA (ms) - 24 horas por defecto
AI_LEARNING_INTERVAL=86400000

# Umbral de confianza para sugerencias de IA (0.0 - 1.0)
AI_CONFIDENCE_THRESHOLD=0.7

# Máximo número de patrones a almacenar por usuario
AI_MAX_PATTERNS=1000

# =====================================
# LÍMITES DE ARCHIVOS Y TRANSFERENCIAS
# =====================================

# Tamaño máximo de archivo para sincronización (bytes) - 100MB
MAX_FILE_SIZE=104857600

# Límite de ancho de banda por usuario (bytes/segundo) - 1MB/s
BANDWIDTH_LIMIT_PER_USER=1048576

# Tamaño máximo de cola de sincronización por usuario
MAX_QUEUE_SIZE=100

# =====================================
# CONFIGURACIÓN DE WATCHDOG
# =====================================

# Intervalo de heartbeat para file watchers (ms)
WATCHER_HEARTBEAT_INTERVAL=60000

# Tiempo de espera antes de considerar un watcher muerto (ms)
WATCHER_TIMEOUT=300000

# =====================================
# CONFIGURACIÓN DE LOGGING
# =====================================

# Nivel de logging (error, warn, info, debug)
LOG_LEVEL=info

# Habilitar logs de debugging para desarrollo
# DEBUG=sync:*

# Directorio para almacenar logs
LOG_DIR=./logs

# Rotación de logs (días)
LOG_ROTATION_DAYS=7

# =====================================
# CONFIGURACIÓN DE CLOUDFLARE TUNNELS
# =====================================

# Token de Cloudflare Tunnel (opcional)
# CLOUDFLARE_TUNNEL_TOKEN=tu_token_aqui

# Dominio personalizado para el tunnel
# CLOUDFLARE_DOMAIN=sync.tudominio.com

# =====================================
# CONFIGURACIÓN DE MICROSOFT GRAPH API
# =====================================

# Client ID de Azure AD
AZURE_CLIENT_ID=tu_client_id_aqui

# Client Secret de Azure AD
AZURE_CLIENT_SECRET=tu_client_secret_aqui

# Tenant ID de Azure AD
AZURE_TENANT_ID=tu_tenant_id_aqui

# =====================================
# CONFIGURACIÓN DE DESARROLLO
# =====================================

# Modo de desarrollo
NODE_ENV=development

# Habilitar hot reload
HOT_RELOAD=true

# Puerto para servidor de desarrollo
DEV_PORT=3000

# =====================================
# CONFIGURACIÓN DE PRODUCCIÓN
# =====================================

# Configuraciones adicionales para producción
# NODE_ENV=production
# COMPRESS_RESPONSES=true
# RATE_LIMIT_WINDOW=900000
# RATE_LIMIT_MAX=100

# =====================================
# CONFIGURACIÓN DE MONITOREO
# =====================================

# Habilitar métricas de rendimiento
ENABLE_METRICS=true

# Intervalo de reporte de métricas (ms)
METRICS_INTERVAL=300000

# URL para webhook de alertas
# ALERT_WEBHOOK_URL=https://tu-webhook-url.com

# =====================================
# CONFIGURACIÓN DE BACKUP
# =====================================

# Habilitar backup automático
ENABLE_AUTO_BACKUP=true

# Intervalo de backup (ms) - 24 horas
BACKUP_INTERVAL=86400000

# Directorio para backups
BACKUP_DIR=./backups

# Número máximo de backups a mantener
MAX_BACKUPS=7

# =====================================
# NOTAS IMPORTANTES
# =====================================

# 1. Cambiar todas las claves secretas en producción
# 2. Usar HTTPS en producción
# 3. Configurar firewall apropiadamente
# 4. Monitorear el uso de recursos
# 5. Realizar backups regulares
# 6. Mantener MongoDB y Redis actualizados